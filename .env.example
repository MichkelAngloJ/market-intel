# Copy to .env and fill locally. Never commit .env.
# Empty value = use the default from code. Check with: uv run python -m market_intel.config

# Required. Allowed: restricted | full | server
#   restricted = testing, cloud databases, no broker keys (rule R1)
#   full       = main work, Docker databases, broker keys allowed
#   server     = later hosting
APP_PROFILE=
# Default: INFO. Allowed: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=
# Default: Asia/Kolkata (display only; storage is always UTC). Any IANA time zone name.
DISPLAY_TIMEZONE=
# Default: data (relative paths resolve from the repo root)
DATA_DIR=
# Default: logs (relative paths resolve from the repo root). JSON log files go here.
LOG_DIR=
# Default: ../market-intel-backups, a folder next to the repo (relative paths resolve from the
# repo root). Must be OUTSIDE the repo. Used by: uv run python -m market_intel.backup
BACKUP_DIR=
# Default: 7. Whole number >= 1. Health (backup_age, full profile only) warns when the newest
# complete backup (one with a manifest) is older than this many days.
BACKUP_MAX_AGE_DAYS=

# --- database group ---
POSTGRES_URL=
MONGODB_URI=

# --- database_admin group (migrations only: "uv run alembic upgrade head") ---
# Owner login, direct (not pooled) connection. App code never uses it.
POSTGRES_ADMIN_URL=

# --- mongo_admin group (setup only: "uv run python -m market_intel.mongo_setup") ---
# Setup login with readWrite + dbAdmin on the Mongo database. App code never uses it.
MONGODB_ADMIN_URI=

# --- database group (continued) ---
# Default: market_intel. Mongo database name (Postgres takes its database from POSTGRES_URL).
MONGODB_DB=
# Default: 15. Seconds to wait when connecting to either database.
DB_CONNECT_TIMEOUT_S=
# Default: 1024 (Neon free plan). db_check warns at 80% of this.
PG_STORAGE_LIMIT_MB=
# Default: 512 (Atlas M0). db_check warns at 80% of this.
MONGO_STORAGE_LIMIT_MB=

# --- upstox group (rule R1: not allowed on the restricted profile) ---
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=
# Upstox's published rate limits per API per user (defaults 50 / 500 / 2000). Change only if
# Upstox changes them. Whole numbers >= 1.
UPSTOX_RATE_PER_SECOND=
UPSTOX_RATE_PER_MINUTE=
UPSTOX_RATE_PER_30MIN=
# Default: 0.8. Share of each limit we use (> 0 and <= 1): 0.8 = 40/s, 400/min, 1600/30 min.
UPSTOX_RATE_HEADROOM=

# --- llm group ---
GEMINI_API_KEY=
GROQ_API_KEY=
PAID_LLM_API_KEY=
# Default: 1000. Must be > 0; above 1000 needs LLM_CAP_RAISE_APPROVED=true; max 2000 (rule R2)
LLM_MONTHLY_CAP_INR=
# Default: 80. Allowed: 1-99 (rule R3)
LLM_WARN_PCT=
# Default: false. Allowed: true | false. Set true only after an approval logged in docs/decisions.md
LLM_CAP_RAISE_APPROVED=

# --- alerts group ---
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_APP_PASSWORD=
# Default: smtp.gmail.com
ALERT_SMTP_HOST=
# Default: 587 (STARTTLS). 465 uses SSL instead.
ALERT_SMTP_PORT=
# Default: 6. Same alert is emailed at most once per this many hours; 0 = no throttle. Must be >= 0.
ALERT_THROTTLE_HOURS=
# Default: false. true = build emails but never send them.
ALERT_DRY_RUN=
