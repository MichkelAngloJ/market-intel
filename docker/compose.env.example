# Copy to docker/compose.env (git-ignored) and fill with long random values.
# Use URL-safe passwords (letters and digits) so they can go into connection URLs as-is.
#
# App .env on the HP then uses, for example:
#   POSTGRES_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:5432/market_intel
#   MONGODB_URI=mongodb://<MONGO_APP_USER>:<MONGO_APP_PASSWORD>@127.0.0.1:27017/market_intel?authSource=market_intel

# Postgres superuser and database (the HP uses market_intel)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Mongo root user (admin only; the app never uses it)
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# Mongo app user: readWrite on market_intel only
MONGO_APP_USER=
MONGO_APP_PASSWORD=
