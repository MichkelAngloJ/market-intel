# Copy to docker/compose.env (git-ignored) and fill with long random values.
# Use URL-safe passwords (letters and digits) so they can go into connection URLs as-is.
#
# App .env on the HP then uses, for example:
#   POSTGRES_ADMIN_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:5432/market_intel
#   POSTGRES_URL=postgresql://mi_app:<PG_APP_PASSWORD>@127.0.0.1:5432/market_intel
#   MONGODB_URI=mongodb://<MONGO_APP_USER>:<MONGO_APP_PASSWORD>@127.0.0.1:27017/market_intel?authSource=admin
#   MONGODB_ADMIN_URI=mongodb://<MONGO_SETUP_USER>:<MONGO_SETUP_PASSWORD>@127.0.0.1:27017/market_intel?authSource=admin

# Postgres superuser and database (the HP uses market_intel). Migrations only.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Password of the limited app login mi_app (created by postgres-init/01-app-role.sh)
PG_APP_PASSWORD=

# Mongo root user (admin only; the app never uses it)
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# Mongo app user: custom role mi_app_rw (read and write documents only, like Atlas)
MONGO_APP_USER=
MONGO_APP_PASSWORD=

# Mongo setup user: readWrite + dbAdmin on market_intel, used only by mongo_setup
MONGO_SETUP_USER=
MONGO_SETUP_PASSWORD=
